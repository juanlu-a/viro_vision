[Unit]
Description=ViroVision — the device's BLE daemon
# NetworkManager ready before starting: the daemon brings the WiFi AP up at startup (ADR 0003) and
# with NM half-started nmcli failed or left the interface without an IP (2026-09-07).
After=bluetooth.target NetworkManager.service network-online.target
Wants=network-online.target
Requires=bluetooth.service

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
# Ask the controller for the shortest connection interval it allows (7.5-15 ms): each interval
# carries a few notifications, so the interval IS the throughput. iOS negotiates it towards 15 ms.
# The "-" makes a missing debugfs not prevent startup.
ExecStartPre=-/bin/sh -c 'echo 6 > /sys/kernel/debug/bluetooth/hci0/conn_min_interval; echo 12 > /sys/kernel/debug/bluetooth/hci0/conn_max_interval'
# Unbuffered: the errors bluez-peripheral prints with print() reach the journal instantly and not
# when the process dies (they were lost this way on 2026-09-05).
Environment=PYTHONUNBUFFERED=1
ExecStart=__INSTALL_DIR__/.venv/bin/python -m virovision
Restart=always
RestartSec=2
# root: BlueZ only accepts registering GATT applications and advertisements from the system bus, and
# D-Bus's default policy allows that to root without touching /etc/dbus-1.
User=root

[Install]
WantedBy=multi-user.target
