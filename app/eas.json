      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "juanlucasabreu@adinet.com.uy",
        "appleTeamId": "VPNXQ8K2P8"
      }
    }
  }
