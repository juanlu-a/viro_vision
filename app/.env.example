# ViroVision app — environment variables (see ADR 0002).
# Copy to `.env` (gitignored) and fill in from your Supabase project settings.
# EXPO_PUBLIC_* vars are inlined into the JS bundle and available at runtime via process.env.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Benchmark de latencia en la nube (SOLO DESARROLLO) ---
#
# ⚠️ Las variables EXPO_PUBLIC_* se INLINEAN en el bundle JS: cualquiera que tenga el .ipa/.apk
#    puede leer esta clave. Es instrumentación de tesis para medir latencia desde el celular,
#    NO puede viajar en un build distribuible. En producción la llamada iría detrás de un proxy.
#
# Se usan únicamente en la pantalla de desarrollo `dev/vision-bench` (ver ADR 0001, nota
# 2026-08-10: la nube es un acelerador opcional, nunca el camino esencial de reconocimiento).
# Sin ninguna clave la pantalla se muestra como "no configurada" en vez de romper.
#
# Gemini es el proveedor primario: tier gratuito SIN TARJETA (aistudio.google.com -> Get API key),
# y sobre todo es de la misma familia que Gemma, así que comparar Gemma local contra Gemini en la
# nube cambia una sola variable (dónde corre el modelo) en vez de dos.
EXPO_PUBLIC_GEMINI_API_KEY=

# Opcional, para contrastar contra otra familia de modelos. Requiere crédito con tarjeta en
# console.anthropic.com (una suscripción a Claude Pro NO habilita la API).
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# --- Dispositivo simulado (SOLO DESARROLLO / DEMO) ---
# Poné 1 para que "Buscar dispositivo" devuelva un dispositivo falso con batería y firmware, y así
# poder ver y demostrar la pantalla de dispositivo conectado sin hardware (B2 está bloqueado por
# compra de componentes). La UI lo rotula como simulado: esto NO finge que el BLE funciona.
EXPO_PUBLIC_SIMULATE_DEVICE=
