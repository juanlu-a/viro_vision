# ViroVision app — environment variables (see ADR 0002).
# Copy to `.env` (gitignored) and fill in from your Supabase project settings.
# EXPO_PUBLIC_* vars are inlined into the JS bundle and available at runtime via process.env.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Modo supermercado: modelo de visión en la nube (ADR 0006) ---
#
# ⚠️ Las variables EXPO_PUBLIC_* se INLINEAN en el bundle JS: cualquiera que tenga el .ipa/.apk
#    puede leer estas claves. Cómo despliega la clave un build distribuible sin credenciales del
#    usuario sigue pendiente en ADR 0006 (la restricción es que el modelo sea gratuito para el
#    usuario). Mientras tanto, los builds de TestFlight/Play la llevan desde los secrets del repo.
#
# Sin ninguna clave, el modo supermercado avisa que no está configurado; el modo ómnibus (OCR
# local) sigue funcionando — es el camino que ADR 0001 exige sin internet.
#
# Gemini es el proveedor primario: tier gratuito SIN TARJETA (aistudio.google.com -> Get API key).
EXPO_PUBLIC_GEMINI_API_KEY=

# Opcional: si está, sus modelos aparecen en el selector de modelo de Inicio para contrastar.
# Requiere crédito con tarjeta en console.anthropic.com (una suscripción a Claude Pro NO habilita
# la API).
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# --- Dispositivo simulado (SOLO DESARROLLO / DEMO) ---
# Poné 1 para que "Buscar dispositivo" devuelva un dispositivo falso con batería y firmware, y así
# poder ver y demostrar la pantalla de dispositivo conectado sin hardware (B2 está bloqueado por
# compra de componentes). La UI lo rotula como simulado: esto NO finge que el BLE funciona.
EXPO_PUBLIC_SIMULATE_DEVICE=
